#include <winresrc.h>

#include "resource.h"

// The side-by-side manifest: visual styles and per-monitor DPI.
1 RT_MANIFEST "vellum.manifest"

// The application icon, as a multi-resolution .ico: 16 through 256 pixels,
// so the title bar, the taskbar, Alt+Tab and Explorer's extra-large view
// each take a frame drawn for their size instead of a rescaled one.
IDI_VELLUM ICON "vellum.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION 1,0,0,0
  PRODUCTVERSION 1,0,0,0
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Vellum PDF and DjVu viewer"
      VALUE "FileVersion",     "1.0.0.0"
      VALUE "InternalName",    "vellum"
      VALUE "OriginalFilename","vellum.exe"
      VALUE "ProductName",     "Vellum"
      VALUE "ProductVersion",  "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
